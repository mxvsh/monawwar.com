---
// Inline word with a tilted, colored squircle icon in front of it.
const icons = {
	pin: '<path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/>',
};

interface Props {
	icon: keyof typeof icons;
	color: string;
	tilt?: number;
	delay?: number;
}

const { icon, color, tilt = -8, delay = 0 } = Astro.props;
---

<span class="group/chip relative whitespace-nowrap text-fg">
	<span
		aria-hidden="true"
		class="mr-1 inline-grid size-[1.4em] translate-y-[0.05em] animate-chip-in place-items-center rounded-[0.42em] text-white shadow-[0_1px_2px_rgb(0_0_0/0.15),inset_0_1px_0_rgb(255_255_255/0.25)] rotate-(--tilt) transition-[rotate,scale] duration-500 ease-spring group-hover/chip:rotate-[calc(var(--tilt)*-1)] group-hover/chip:scale-110 supports-[corner-shape:squircle]:rounded-[45%] supports-[corner-shape:squircle]:[corner-shape:squircle]"
		style={`background:${color};--tilt:${tilt}deg;animation-delay:${delay}ms`}
	>
		<svg
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2.25"
			stroke-linecap="round"
			stroke-linejoin="round"
			class="size-[0.8em]"
			set:html={icons[icon]}
		/>
	</span><slot />
</span>
