---
interface Shot {
	src: string;
	alt: string;
	width: number;
	height: number;
}

interface Props {
	shots?: Shot[];
	i?: number;
}

const { shots = [], i = 0 } = Astro.props;
const single = shots.length === 1;
const portrait = single && shots[0].height > shots[0].width;
---

{
	shots.length > 0 && (
		<div
			class:list={[
				"reveal mt-14 flex snap-x snap-mandatory gap-3 mx-[calc(var(--bleed)*-1)] overflow-x-auto px-(--bleed) py-px scroll-px-(--bleed) [--g:1.5rem] sm:[--g:2rem] [--bleed:max(var(--g),calc((100vw-42rem)/2+var(--g)))] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden",
				portrait && "justify-center",
			]}
			style={`--i: ${i}`}
		>
			{shots.map((s, n) => (
				<img
					src={s.src}
					alt={s.alt}
					width={s.width}
					height={s.height}
					loading={n === 0 ? "eager" : "lazy"}
					class:list={[
						"shrink-0 snap-start ring-1 ring-line",
						portrait
							? "h-auto w-64 rounded-[2rem] sm:w-72"
							: single
								? "h-auto w-full rounded-2xl"
								: "h-56 w-auto rounded-2xl sm:h-80",
					]}
				/>
			))}
		</div>
	)
}
