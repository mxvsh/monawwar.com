---
interface Shot {
	src: string;
	alt: string;
	width: number;
	height: number;
}

interface Props {
	shots?: Shot[];
	i?: number;
}

const { shots = [], i = 0 } = Astro.props;
const single = shots.length === 1;
---

{
	shots.length > 0 && (
		<div
			class="reveal mt-14 flex snap-x snap-mandatory gap-3 mx-[calc(var(--bleed)*-1)] overflow-x-auto px-(--bleed) py-px scroll-px-(--bleed) [--g:1.5rem] sm:[--g:2rem] [--bleed:max(var(--g),calc((100vw-42rem)/2+var(--g)))] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
			style={`--i: ${i}`}
		>
			{shots.map((s, n) => (
				<img
					src={s.src}
					alt={s.alt}
					width={s.width}
					height={s.height}
					loading={n === 0 ? "eager" : "lazy"}
					class:list={[
						"h-auto shrink-0 snap-start rounded-2xl ring-1 ring-line",
						single ? "w-full" : "w-[88%]",
					]}
				/>
			))}
		</div>
	)
}
