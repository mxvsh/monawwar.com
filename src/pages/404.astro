---
import Layout from "../layouts/Layout.astro";
import ThemeToggle from "../components/ThemeToggle";

const title = "Page not found — Monawwar Abdullah";
const description = "This page doesn't exist. It may have moved, or the link might be wrong.";

const tiles = [
	{ char: "4", tilt: -10, delay: 200 },
	{ char: "0", tilt: 6, delay: 300 },
	{ char: "4", tilt: -4, delay: 400 },
];

const links = [
	{ href: "/", label: "Home" },
	{ href: "/apps/wave", label: "Wave" },
	{ href: "/apps/typecam", label: "TypeCam" },
	{ href: "/contact", label: "Contact" },
];
---

<Layout title={title} description={description} path="/404">
	<meta slot="head" name="robots" content="noindex" />

	<div
		aria-hidden="true"
		class="pointer-events-none fixed inset-x-0 top-0 -z-10 h-80 bg-[radial-gradient(60%_100%_at_50%_0%,var(--surface),transparent)]"
	>
	</div>

	<div class="mx-auto flex min-h-dvh max-w-2xl flex-col px-6 sm:px-8">
		<header class="reveal flex items-center justify-between pt-8 sm:pt-12">
			<a
				href="/"
				aria-label="Home"
				class="block size-9 overflow-hidden rounded-full ring-1 ring-line transition-transform duration-300 ease-out-soft hover:scale-105"
			>
				<img src="/avatar.jpg" alt="Monawwar Abdullah" width="36" height="36" class="size-full object-cover" />
			</a>
			<ThemeToggle client:load />
		</header>

		<main class="flex flex-1 flex-col justify-center py-20">
			<div aria-hidden="true" class="flex gap-3 sm:gap-4">
				{
					tiles.map((t, i) => (
						<span
							class="grid size-20 animate-chip-in place-items-center rounded-[22px] bg-surface font-mono text-4xl font-medium text-fg shadow-[0_1px_2px_rgb(0_0_0/0.06),inset_0_1px_0_rgb(255_255_255/0.5)] ring-1 ring-line rotate-(--tilt) transition-[rotate,scale] duration-500 ease-spring hover:rotate-[calc(var(--tilt)*-1)] hover:scale-110 sm:size-24 sm:rounded-[26px] sm:text-5xl dark:shadow-[0_1px_2px_rgb(0_0_0/0.4),inset_0_1px_0_rgb(255_255_255/0.04)] supports-[corner-shape:squircle]:rounded-[45%] supports-[corner-shape:squircle]:[corner-shape:squircle]"
							style={`--tilt:${t.tilt}deg;--float-delay:${i * -1.2}s;animation-delay:${t.delay}ms`}
						>
							<span class="float block">{t.char}</span>
						</span>
					))
				}
			</div>

			<h1 class="reveal mt-12 text-2xl font-medium tracking-tight text-fg sm:text-3xl" style="--i: 5">
				Nothing here
			</h1>
			<p class="reveal mt-3 max-w-lg text-[17px] leading-8 text-muted" style="--i: 6">
				<code id="missing-path" class="break-all rounded-md bg-surface px-1.5 py-0.5 font-mono text-[14px] text-fg ring-1 ring-line"
					>This page</code
				>{" "}
				doesn't exist. It may have moved, or the link might be wrong.
			</p>

			<div class="reveal mt-8 flex flex-wrap items-center gap-3" style="--i: 7">
				<a
					href="/"
					class="group inline-flex h-10 items-center gap-2 rounded-full bg-fg px-4 text-sm font-medium text-bg transition-opacity duration-200 hover:opacity-85"
				>
					<svg
						aria-hidden="true"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="size-4 transition-transform duration-300 ease-out-soft group-hover:-translate-x-0.5"
					>
						<path d="M19 12H5M12 19l-7-7 7-7"></path>
					</svg>
					Back home
				</a>
			</div>

			<nav class="reveal mt-16" style="--i: 8" aria-label="Pages">
				<h2 class="mb-4 font-mono text-xs uppercase tracking-[0.14em] text-subtle">Try instead</h2>
				<ul class="flex flex-wrap gap-x-6 gap-y-2 text-[15px]">
					{
						links.map((l) => (
							<li>
								<a href={l.href} class="link-underline text-fg">
									{l.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
		</main>

		<footer
			class="reveal flex items-center justify-between border-t border-line py-8 font-mono text-xs text-subtle"
			style="--i: 9"
		>
			<span>&copy; {new Date().getFullYear()} Monawwar Abdullah</span>
			<span>monawwar.com</span>
		</footer>
	</div>

	<script is:inline>
		const path = decodeURIComponent(location.pathname);
		if (path !== "/404") document.getElementById("missing-path").textContent = path;
	</script>
</Layout>

<style>
	.float {
		animation: float 3.6s ease-in-out infinite;
		animation-delay: var(--float-delay);
	}

	@keyframes float {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-4px);
		}
	}
</style>
