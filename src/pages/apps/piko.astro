---
import Layout from "../../layouts/Layout.astro";
import ThemeToggle from "../../components/ThemeToggle";

const title = "Piko — Quick mini games";
const description =
	"Piko is a collection of quick mini games with personal records, seasonal leaderboards and friends. Starting with Road Hop.";

const features = [
	{ title: "Quick runs", text: "Jump in, play for a minute, beat your best." },
	{ title: "Personal records", text: "Every game tracks your best, season by season." },
	{ title: "Friends", text: "Follow friends' records and send beat-my-score challenges." },
	{ title: "Offline", text: "Play anywhere. Your runs sync when you're back online." },
];
---

<Layout title={title} description={description} path="/apps/piko">
	<div
		aria-hidden="true"
		class="pointer-events-none fixed inset-x-0 top-0 -z-10 h-80 bg-[radial-gradient(60%_100%_at_50%_0%,var(--surface),transparent)]"
	>
	</div>

	<div class="mx-auto flex min-h-dvh max-w-2xl flex-col px-6 sm:px-8">
		<header class="reveal flex items-center justify-between pt-8 sm:pt-12">
			<a
				href="/"
				aria-label="Home"
				class="block size-9 overflow-hidden rounded-full ring-1 ring-line transition-transform duration-300 ease-out-soft hover:scale-105"
			>
				<img src="/avatar.jpg" alt="Monawwar Abdullah" width="36" height="36" class="size-full object-cover" />
			</a>
			<ThemeToggle client:load />
		</header>

		<main class="flex-1 pt-20 sm:pt-28">
			<section>
				<h1 class="reveal text-2xl font-medium tracking-tight text-fg sm:text-3xl" style="--i: 1">Piko</h1>
				<p class="reveal mt-1.5 text-muted" style="--i: 2">Quick mini games for iOS and Android</p>
				<p class="reveal mt-8 max-w-lg text-[17px] leading-8 text-muted" style="--i: 3">
					A collection of small games built for short breaks, with personal records, seasonal
					leaderboards and friends. It starts with <span class="text-fg">Road Hop</span>, a 3D voxel
					road-crossing runner, and more games are on the way.
				</p>
			</section>

			<div class="reveal mt-14 flex justify-center" style="--i: 4">
				<img
					src="/apps/piko/home.jpg"
					alt="Piko home screen with Road Hop and a coming soon game"
					width="800"
					height="1739"
					class="w-64 rounded-[2rem] ring-1 ring-line sm:w-72"
				/>
			</div>

			<section class="mt-20 sm:mt-24">
				<h2 class="reveal mb-6 font-mono text-xs uppercase tracking-[0.14em] text-subtle" style="--i: 5">
					Features
				</h2>
				<ul class="reveal space-y-4 text-[15px]" style="--i: 6">
					{
						features.map((f) => (
							<li class="flex gap-4">
								<span class="w-32 shrink-0 text-fg">{f.title}</span>
								<span class="text-muted">{f.text}</span>
							</li>
						))
					}
				</ul>
			</section>

			<section class="mt-20 sm:mt-24">
				<h2 class="reveal mb-6 font-mono text-xs uppercase tracking-[0.14em] text-subtle" style="--i: 7">
					Support
				</h2>
				<p class="reveal max-w-lg leading-relaxed text-muted" style="--i: 7">
					Questions or feedback about Piko? <a href="/contact" class="link-underline text-fg">Get in touch</a>.
				</p>
			</section>
		</main>

		<footer
			class="reveal mt-24 flex items-center justify-between border-t border-line py-8 font-mono text-xs text-subtle"
			style="--i: 8"
		>
			<span>&copy; {new Date().getFullYear()} Monawwar Abdullah</span>
			<span>monawwar.com</span>
		</footer>
	</div>
</Layout>
