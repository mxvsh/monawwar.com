---
import Layout from "../../layouts/Layout.astro";
import ThemeToggle from "../../components/ThemeToggle";

const repo = "https://github.com/mxvsh/TypeCam";
const path = "/apps/typecam";

const title = "TypeCam — Use your iPhone as a wired camera for OBS";
const description =
	"TypeCam turns your iPhone into a low-latency, wired camera for OBS Studio on macOS. Hardware-encoded HEVC over the USB cable, pro camera controls and mic audio. Open source.";

const steps = [
	{ title: "Plug in", text: "Connect your iPhone to your Mac with a USB-C or Lightning cable and tap Trust." },
	{ title: "Open TypeCam", text: "The app starts serving its camera feed over the cable. No Wi-Fi, no pairing." },
	{ title: "Add the source", text: "In OBS, add a TypeCam (iPhone) source. The feed is live in a moment." },
];

const features = [
	{ title: "Wired", text: "Streams over Apple's USB tunnel, the same link Xcode uses. Nothing touches your network." },
	{ title: "Low latency", text: "Real-time H.264 or HEVC with no B-frames. Frames are dropped, never queued." },
	{ title: "Up to 4K60", text: "720p, 1080p or 4K at 24 to 60 fps, with auto or manual bitrate." },
	{ title: "Pro controls", text: "Every lens, manual focus, ISO, shutter, EV and white balance lock on ruler dials." },
	{ title: "Audio", text: "Mic audio in sync with video, as PCM or AAC, with gain, presets and a low-cut filter." },
	{ title: "Assist", text: "Grid, level, histogram, zebra and focus peaking. Preview only, never in the stream." },
	{ title: "Multi-camera", text: "Plug in two iPhones and use them as two separate OBS sources." },
	{ title: "Open source", text: "A Swift app and a C plugin, built with Apple frameworks only." },
];

const requirements = [
	{ label: "iPhone", value: "iOS 18 or later" },
	{ label: "Mac", value: "macOS 13 or later" },
	{ label: "OBS", value: "OBS Studio 31 or later" },
	{ label: "Cable", value: "USB-C or Lightning" },
];

const faqs = [
	{
		q: "Does TypeCam need Wi-Fi?",
		a: "No. Video and audio travel over the USB cable through usbmuxd, which is built into macOS. Your phone and Mac don't even need to be on the same network.",
	},
	{
		q: "How low is the latency?",
		a: "TypeCam targets under 100 ms from glass to OBS at 1080p60. It uses a real-time hardware encoder, short keyframe intervals and small queues.",
	},
	{
		q: "Does it work on Windows or Linux?",
		a: "Not yet. Version 1 is macOS only. Windows and Linux plugin builds are on the roadmap.",
	},
	{
		q: "Is it free?",
		a: "Yes. TypeCam is open source on GitHub, and contributions are welcome.",
	},
];

const jsonLd = [
	{
		"@context": "https://schema.org",
		"@type": "SoftwareApplication",
		name: "TypeCam",
		description,
		url: `https://monawwar.com${path}`,
		image: "https://monawwar.com/apps/typecam/icon.png",
		applicationCategory: "MultimediaApplication",
		operatingSystem: "iOS 18, macOS 13",
		offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
		author: { "@type": "Person", name: "Monawwar Abdullah", url: "https://monawwar.com" },
		sameAs: [repo],
	},
	{
		"@context": "https://schema.org",
		"@type": "FAQPage",
		mainEntity: faqs.map((f) => ({
			"@type": "Question",
			name: f.q,
			acceptedAnswer: { "@type": "Answer", text: f.a },
		})),
	},
];
---

<Layout
	title={title}
	description={description}
	path={path}
	image="/apps/typecam/og.png"
	imageAlt="TypeCam: your iPhone as a wired, low-latency camera for OBS"
	icon="/apps/typecam/icon.png"
>
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

	<div
		aria-hidden="true"
		class="pointer-events-none fixed inset-x-0 top-0 -z-10 h-80 bg-[radial-gradient(60%_100%_at_50%_0%,var(--surface),transparent)]"
	>
	</div>

	<div class="mx-auto flex min-h-dvh max-w-2xl flex-col px-6 sm:px-8">
		<header class="reveal flex items-center justify-between pt-8 sm:pt-12">
			<a
				href="/"
				aria-label="Home"
				class="block size-9 overflow-hidden rounded-full ring-1 ring-line transition-transform duration-300 ease-out-soft hover:scale-105"
			>
				<img src="/avatar.jpg" alt="Monawwar Abdullah" width="36" height="36" class="size-full object-cover" />
			</a>
			<ThemeToggle client:load />
		</header>

		<main class="flex-1 pt-20 sm:pt-28">
			<section>
				<img
					src="/apps/typecam/icon.webp"
					alt="TypeCam app icon"
					width="64"
					height="64"
					class="reveal size-16 rounded-[18px] ring-1 ring-line"
					style="--i: 1"
				/>
				<h1 class="reveal mt-6 text-2xl font-medium tracking-tight text-fg sm:text-3xl" style="--i: 1">
					TypeCam
				</h1>
				<p class="reveal mt-1.5 text-muted" style="--i: 2">Your iPhone as a wired camera for OBS</p>
				<p class="reveal mt-8 max-w-lg text-[17px] leading-8 text-muted" style="--i: 3">
					Plug your iPhone into your Mac and use it as a{" "}
					<span class="text-fg">sharp, low-latency camera</span> in OBS Studio. TypeCam hardware-encodes video and audio on the phone and sends it straight down the
					cable. No Wi-Fi, no network setup, no subscription.
				</p>

				<div class="reveal mt-8 flex flex-wrap items-center gap-3" style="--i: 4">
					<a
						href={repo}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex h-10 items-center gap-2 rounded-full bg-fg px-4 text-sm font-medium text-bg transition-opacity duration-200 hover:opacity-85"
					>
						<svg aria-hidden="true" viewBox="0 0 16 16" class="size-4 fill-current">
							<path
								d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
							></path>
						</svg>
						View on GitHub
					</a>
					<span
						class="inline-flex h-10 items-center gap-2 rounded-full px-4 font-mono text-xs text-subtle ring-1 ring-line"
					>
						<span class="relative flex size-1.5">
							<span class="absolute inline-flex size-full animate-ping rounded-full bg-amber-500 opacity-60"></span>
							<span class="relative inline-flex size-1.5 rounded-full bg-amber-500"></span>
						</span>
						v1 in development
					</span>
				</div>
			</section>

			<section class="mt-20 sm:mt-24">
				<h2 class="reveal mb-6 font-mono text-xs uppercase tracking-[0.14em] text-subtle" style="--i: 5">
					How it works
				</h2>
				<ol class="reveal grid gap-3 sm:grid-cols-3" style="--i: 5">
					{
						steps.map((s, i) => (
							<li class="rounded-2xl bg-surface/60 p-5 ring-1 ring-line">
								<span class="font-mono text-xs text-subtle">0{i + 1}</span>
								<h3 class="mt-3 text-[15px] font-medium text-fg">{s.title}</h3>
								<p class="mt-1.5 text-sm leading-relaxed text-muted">{s.text}</p>
							</li>
						))
					}
				</ol>
			</section>

			<section class="mt-20 sm:mt-24">
				<h2 class="reveal mb-6 font-mono text-xs uppercase tracking-[0.14em] text-subtle" style="--i: 6">
					Features
				</h2>
				<ul class="reveal space-y-4 text-[15px]" style="--i: 6">
					{
						features.map((f) => (
							<li class="flex flex-col gap-0.5 sm:flex-row sm:gap-4">
								<span class="shrink-0 text-fg sm:w-32">{f.title}</span>
								<span class="text-muted">{f.text}</span>
							</li>
						))
					}
				</ul>
			</section>

			<section class="mt-20 sm:mt-24">
				<h2 class="reveal mb-6 font-mono text-xs uppercase tracking-[0.14em] text-subtle" style="--i: 7">
					Requirements
				</h2>
				<dl class="reveal space-y-3 text-[15px]" style="--i: 7">
					{
						requirements.map((r) => (
							<div class="flex items-center gap-4">
								<dt class="w-20 shrink-0 font-mono text-xs text-subtle">{r.label}</dt>
								<dd class="text-fg">{r.value}</dd>
							</div>
						))
					}
				</dl>
			</section>

			<section class="mt-20 sm:mt-24">
				<h2 class="reveal mb-2 font-mono text-xs uppercase tracking-[0.14em] text-subtle" style="--i: 8">
					FAQ
				</h2>
				<div class="reveal divide-y divide-line" style="--i: 8">
					{
						faqs.map((f) => (
							<details class="group py-4">
								<summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[15px] text-fg [&::-webkit-details-marker]:hidden">
									{f.q}
									<span
										aria-hidden="true"
										class="font-mono text-subtle transition-transform duration-300 ease-out-soft group-open:rotate-45"
									>
										+
									</span>
								</summary>
								<p class="mt-2 max-w-lg text-sm leading-relaxed text-muted">{f.a}</p>
							</details>
						))
					}
				</div>
			</section>

			<section class="mt-20 sm:mt-24">
				<h2 class="reveal mb-6 font-mono text-xs uppercase tracking-[0.14em] text-subtle" style="--i: 9">
					Contribute
				</h2>
				<p class="reveal max-w-lg leading-relaxed text-muted" style="--i: 9">
					TypeCam is built in the open. Read the{" "}
					<a href={`${repo}/tree/main/docs`} target="_blank" rel="noopener noreferrer" class="link-underline text-fg">docs</a>,
					open an{" "}
					<a href={`${repo}/issues`} target="_blank" rel="noopener noreferrer" class="link-underline text-fg">issue</a>{" "}
					or <a href="/contact" class="link-underline text-fg">get in touch</a>.
				</p>
			</section>
		</main>

		<footer
			class="reveal mt-24 flex items-center justify-between border-t border-line py-8 font-mono text-xs text-subtle"
			style="--i: 10"
		>
			<span>&copy; {new Date().getFullYear()} Monawwar Abdullah</span>
			<span>monawwar.com</span>
		</footer>
	</div>
</Layout>
