---
import Layout from "../layouts/Layout.astro";
import ThemeToggle from "../components/ThemeToggle";
import CopyEmail from "../components/CopyEmail";
import { email, socials } from "../lib/contact";

const title = "Contact — Monawwar Abdullah";
const description = "Get in touch with Monawwar Abdullah for questions, support or feedback.";
---

<Layout title={title} description={description} path="/contact">
	<div
		aria-hidden="true"
		class="pointer-events-none fixed inset-x-0 top-0 -z-10 h-80 bg-[radial-gradient(60%_100%_at_50%_0%,var(--surface),transparent)]"
	>
	</div>

	<div class="mx-auto flex min-h-dvh max-w-2xl flex-col px-6 sm:px-8">
		<header class="reveal flex items-center justify-between pt-8 sm:pt-12">
			<a
				href="/"
				aria-label="Home"
				class="block size-9 overflow-hidden rounded-full ring-1 ring-line transition-transform duration-300 ease-out-soft hover:scale-105"
			>
				<img src="/avatar.jpg" alt="Monawwar Abdullah" width="36" height="36" class="size-full object-cover" />
			</a>
			<ThemeToggle client:load />
		</header>

		<main class="flex-1 pt-20 sm:pt-28">
			<h1 class="reveal text-2xl font-medium tracking-tight text-fg sm:text-3xl" style="--i: 1">Contact</h1>
			<p class="reveal mt-4 max-w-lg text-[17px] leading-8 text-muted" style="--i: 2">
				Questions, support requests or feedback about any of my apps? Send an email and I'll get
				back to you. You can also reach me on{" "}
				<a href="https://x.com/monawwarx" target="_blank" rel="noopener noreferrer" class="link-underline text-fg">X</a>.
			</p>

			<ul class="reveal mt-10 space-y-3 text-[15px]" style="--i: 3">
				<li class="flex items-center gap-4">
					<span class="w-20 shrink-0 font-mono text-xs text-subtle">Email</span>
					<a href={`mailto:${email}`} class="link-underline text-fg">{email}</a>
					<CopyEmail client:visible email={email} />
				</li>
				{
					socials.map((s) => (
						<li class="flex items-center gap-4">
							<span class="w-20 shrink-0 font-mono text-xs text-subtle">{s.label}</span>
							<a
								href={s.href}
								target="_blank"
								rel="noopener noreferrer"
								class="link-underline text-fg"
							>
								@{s.handle}
							</a>
						</li>
					))
				}
			</ul>
		</main>

		<footer
			class="reveal mt-24 flex items-center justify-between border-t border-line py-8 font-mono text-xs text-subtle"
			style="--i: 4"
		>
			<span>&copy; {new Date().getFullYear()} Monawwar Abdullah</span>
			<span>monawwar.com</span>
		</footer>
	</div>
</Layout>
