---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import ThemeToggle from "../components/ThemeToggle";
import ProjectList from "../components/ProjectList";
import CopyEmail from "../components/CopyEmail";
import Chip from "../components/Chip.astro";
import { email, socials } from "../lib/contact";

const projects = (await getCollection("projects"))
	.sort((a, b) => a.data.order - b.data.order)
	.map(({ data }) => ({ name: data.name, description: data.description, link: data.link, logo: data.logo }));

const title = "Monawwar Abdullah — Software Engineer";
const description =
	"Software engineer building clean, functional web tools. Creator of Skid, Jelly, Drivebase, Wave, and SVG Logo.";

---

<Layout title={title} description={description}>
	<div
		aria-hidden="true"
		class="pointer-events-none fixed inset-x-0 top-0 -z-10 h-80 bg-[radial-gradient(60%_100%_at_50%_0%,var(--surface),transparent)]"
	>
	</div>

	<div class="mx-auto flex min-h-dvh max-w-2xl flex-col px-6 sm:px-8">
		<header class="reveal flex items-center justify-between pt-8 sm:pt-12">
			<a
				href="/"
				aria-label="Home"
				class="block size-9 overflow-hidden rounded-full ring-1 ring-line transition-transform duration-300 ease-out-soft hover:scale-105"
			>
				<img src="/avatar.jpg" alt="Monawwar Abdullah" width="36" height="36" class="size-full object-cover" />
			</a>
			<ThemeToggle client:load />
		</header>

		<main class="flex-1 pt-20 sm:pt-28">
			<section>
				<h1 class="reveal text-2xl font-medium tracking-tight text-fg sm:text-3xl" style="--i: 1">
					Monawwar Abdullah
				</h1>
				<p class="reveal mt-1.5 text-muted" style="--i: 2">Software Engineer</p>
				<div class="reveal mt-8 max-w-lg space-y-4 text-[17px] leading-8 text-muted" style="--i: 3">
					<p>
						Born and raised in <Chip icon="pin" color="#f43f5e" tilt={-8} delay={450}>Bhagalpur</Chip>,
						Bihar. Programming started as a curiosity and never really stopped being one.
					</p>
					<p>
						I dropped out of college in 2019 to work on software full time. Since then I've shipped
						projects across the stack — web apps, native apps, CLIs, and plenty in between.
						I'm focused on <span class="text-fg">small, well-made tools.</span>
					</p>
				</div>
			</section>

			<section class="mt-20 sm:mt-24">
				<h2 class="reveal mb-4 font-mono text-xs uppercase tracking-[0.14em] text-subtle" style="--i: 4">
					Projects
				</h2>
				<div class="reveal" style="--i: 5">
					<ProjectList client:idle projects={projects} />
				</div>
			</section>

			<section class="mt-20 sm:mt-24">
				<h2 class="reveal mb-6 font-mono text-xs uppercase tracking-[0.14em] text-subtle" style="--i: 6">
					Contact
				</h2>
				<p class="reveal mb-6 max-w-lg leading-relaxed text-muted" style="--i: 6">
					The best way to reach me is on{" "}
					<a href="https://x.com/monawwarx" target="_blank" rel="noopener noreferrer" class="link-underline text-fg">X</a>.
				</p>
				<ul class="reveal space-y-3 text-[15px]" style="--i: 7">
					<li class="flex items-center gap-4">
						<span class="w-20 shrink-0 font-mono text-xs text-subtle">Email</span>
						<a href={`mailto:${email}`} class="link-underline text-fg">{email}</a>
						<CopyEmail client:visible email={email} />
					</li>
					{
						socials.map((s) => (
							<li class="flex items-center gap-4">
								<span class="w-20 shrink-0 font-mono text-xs text-subtle">{s.label}</span>
								<a
									href={s.href}
									target="_blank"
									rel="noopener noreferrer"
									class="link-underline text-fg"
								>
									@{s.handle}
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>

		<footer
			class="reveal mt-24 flex items-center justify-between border-t border-line py-8 font-mono text-xs text-subtle"
			style="--i: 8"
		>
			<span>&copy; {new Date().getFullYear()} Monawwar Abdullah</span>
			<span>monawwar.com</span>
		</footer>
	</div>
</Layout>
