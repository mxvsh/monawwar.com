---
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort(
	(a, b) => a.data.order - b.data.order,
);

const title = "Monawwar Abdullah — Software Engineer";
const description =
	"Software engineer building clean, functional web tools. Creator of Drivebase, Wave, and SVG Logo.";
const siteUrl = "https://monawwar.com";
const ogImage = `${siteUrl}/og.jpg`;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/favicon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={siteUrl} />

		<meta property="og:type" content="website" />
		<meta property="og:url" content={siteUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@monawwarx" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<style>
			@media (prefers-color-scheme: dark) {
				body {
					background: #000;
					color: #fff;
				}
				a {
					color: #6cf;
				}
			}
		</style>
	</head>
	<body>
		<h1>Monawwar Abdullah</h1>
		<p>Software Engineer</p>

		<h2>About</h2>
		<p>
			I write software. Mostly web stuff, sometimes other things. I like
			building tools that work well and get out of the way.
		</p>

		<h2>Projects</h2>
		<ul>
			{
				projects.map((project) => (
					<li>
						<a href={project.data.link} target="_blank" rel="noopener noreferrer">{project.data.name}</a>
						{" — "}
						{project.data.description}
					</li>
				))
			}
		</ul>

		<h2>Contact</h2>
		<ul>
			<li>
				<a href="mailto:hello@monawwar.com">Email</a>
			</li>
			<li>
				<a href="https://github.com/mxvsh" target="_blank" rel="noopener noreferrer">GitHub</a>
			</li>
			<li>
				<a href="https://x.com/monawwarx" target="_blank" rel="noopener noreferrer">X</a>
			</li>
			<li>
				<a href="https://linkedin.com/in/monawwar" target="_blank" rel="noopener noreferrer">LinkedIn</a>
			</li>
		</ul>

		<p>&copy; 2026 Monawwar Abdullah. All rights reserved.</p>
	</body>
</html>
