---
import Layout from "../../layouts/Layout.astro";
import ThemeToggle from "../../components/ThemeToggle";
import ProjectBrowser from "../../components/ProjectBrowser";
import { getProjects } from "../../lib/projects";

const projects = await getProjects();

const title = "Projects — Monawwar Abdullah";
const description = `Apps and tools built by Monawwar Abdullah: ${projects.map((p) => p.name).join(", ")}.`;
---

<Layout title={title} description={description} path="/projects">
	<div
		aria-hidden="true"
		class="pointer-events-none fixed inset-x-0 top-0 -z-10 h-80 bg-[radial-gradient(60%_100%_at_50%_0%,var(--surface),transparent)]"
	>
	</div>

	<div class="mx-auto flex min-h-dvh max-w-2xl flex-col px-6 sm:px-8">
		<header class="reveal flex items-center justify-between pt-8 sm:pt-12">
			<a
				href="/"
				aria-label="Home"
				class="block size-9 overflow-hidden rounded-full ring-1 ring-line transition-transform duration-300 ease-out-soft hover:scale-105"
			>
				<img src="/avatar.jpg" alt="Monawwar Abdullah" width="36" height="36" class="size-full object-cover" />
			</a>
			<ThemeToggle client:load />
		</header>

		<main class="flex-1 pt-16 sm:pt-24">
			<h1 class="reveal text-2xl font-medium tracking-tight text-fg sm:text-3xl" style="--i: 1">Projects</h1>
			<p class="reveal mt-1.5 text-muted" style="--i: 2">Apps and tools I've built, newest first.</p>
			<div class="reveal mt-8" style="--i: 3">
				<ProjectBrowser client:load projects={projects} />
			</div>
		</main>

		<footer
			class="reveal mt-24 flex items-center justify-between border-t border-line py-8 font-mono text-xs text-subtle"
			style="--i: 4"
		>
			<span>&copy; {new Date().getFullYear()} Monawwar Abdullah</span>
			<a href="/" class="link-underline">monawwar.com</a>
		</footer>
	</div>
</Layout>
