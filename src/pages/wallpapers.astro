---
import Layout from "../layouts/Layout.astro";
import ThemeToggle from "../components/ThemeToggle";
import WallpaperGrid from "../components/WallpaperGrid";
import { getWallpapers } from "../lib/wallpapers";

const wallpapers = getWallpapers();

const title = "Wallpapers — Monawwar Abdullah";
const description = "High-quality wallpapers for iPhone and Mac, free to download in full resolution.";
---

<Layout title={title} description={description} path="/wallpapers">
	<div
		aria-hidden="true"
		class="pointer-events-none fixed inset-x-0 top-0 -z-10 h-80 bg-[radial-gradient(60%_100%_at_50%_0%,var(--surface),transparent)]"
	>
	</div>

	<div class="mx-auto flex min-h-dvh max-w-5xl flex-col px-6 sm:px-8">
		<header class="reveal flex items-center justify-between pt-8 sm:pt-12">
			<a
				href="/"
				aria-label="Home"
				class="block size-9 overflow-hidden rounded-full ring-1 ring-line transition-transform duration-300 ease-out-soft hover:scale-105"
			>
				<img src="/avatar.jpg" alt="Monawwar Abdullah" width="36" height="36" class="size-full object-cover" />
			</a>
			<ThemeToggle client:load />
		</header>

		<main class="flex-1 pt-16 sm:pt-24">
			<h1 class="reveal font-display text-5xl font-semibold tracking-tight text-fg sm:text-6xl" style="--i: 1">Wallpapers</h1>
			<p class="reveal mt-3 max-w-md text-lg text-muted" style="--i: 2">
				High-quality wallpapers for iPhone and Mac. Free to download in full resolution.
			</p>
			<div class="reveal mt-10" style="--i: 3">
				<WallpaperGrid client:load wallpapers={wallpapers} />
			</div>
		</main>

		<footer
			class="reveal mt-24 flex items-center justify-between border-t border-line py-8 text-sm text-subtle"
			style="--i: 4"
		>
			<span>&copy; {new Date().getFullYear()} Monawwar Abdullah</span>
		</footer>
	</div>
</Layout>
